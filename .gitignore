# Local environment values; keep shareable templates
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Python bytecode, virtual environments, and packaging
__pycache__/
*.py[cod]
.venv/
venv/
.eggs/
*.egg-info/
build/
dist/

# Python tooling caches and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Node dependencies and browser-test output
node_modules/
/playwright-report/
/test-results/
/blob-report/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ad-hoc server logs and PID files in the repository root
/*.log
/*.pid
/*.pid.lock

# Editor swap/backup files and operating-system metadata
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
